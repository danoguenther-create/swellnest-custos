TELEGRAM_BOT_TOKEN=<von @BotFather>
# Wer mit dem Bot sprechen darf (kommagetrennt). Leer = niemand (fail-closed).
TELEGRAM_ALLOWED_CHATS=<chat-id>[,<chat-id>]
# Admin: bekommt Hinweise, wenn jemand sein Kontingent erreicht.
TELEGRAM_CHAT_ID=<chat-id>
SWELLNEST_DB=/home/daniel/swellnest-bot/custos.sqlite3

# Optional — Schutz vor Missbrauch und Verbrauch (Standardwerte in Klammern)
# MAX_MESSAGE_LENGTH=300
# RATE_PER_HOUR=40
# RATE_PER_DAY=150
# Modell fuer den Parser, z.B. haiku oder sonnet. Leer = Standard der Claude-CLI.
# CLAUDE_MODEL=
